# Firebase Web Configuration
FIREBASE_WEB_API_KEY=your_web_api_key
FIREBASE_WEB_APP_ID=your_web_app_id
FIREBASE_WEB_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_WEB_PROJECT_ID=your_project_id
FIREBASE_WEB_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_WEB_DATABASE_URL=https://your_project.firebaseio.com
FIREBASE_WEB_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_WEB_MEASUREMENT_ID=your_measurement_id

# Firebase Android Configuration
FIREBASE_ANDROID_API_KEY=your_android_api_key
FIREBASE_ANDROID_APP_ID=your_android_app_id
FIREBASE_ANDROID_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_ANDROID_PROJECT_ID=your_project_id
FIREBASE_ANDROID_DATABASE_URL=https://your_project.firebaseio.com
FIREBASE_ANDROID_STORAGE_BUCKET=your_project.appspot.com

# Firebase iOS Configuration
FIREBASE_IOS_API_KEY=your_ios_api_key
FIREBASE_IOS_APP_ID=your_ios_app_id
FIREBASE_IOS_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_IOS_PROJECT_ID=your_project_id
FIREBASE_IOS_DATABASE_URL=https://your_project.firebaseio.com
FIREBASE_IOS_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_IOS_BUNDLE_ID=com.example.vehicle

# Firebase macOS Configuration
FIREBASE_MACOS_API_KEY=your_macos_api_key
FIREBASE_MACOS_APP_ID=your_macos_app_id
FIREBASE_MACOS_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_MACOS_PROJECT_ID=your_project_id
FIREBASE_MACOS_DATABASE_URL=https://your_project.firebaseio.com
FIREBASE_MACOS_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MACOS_BUNDLE_ID=com.example.vehicle.RunnerTests

# User Credentials
STUDENT_ID=your_student_id
STUDENT_PASSWORD=your_student_password
ADMIN_ID=your_admin_id
ADMIN_PASSWORD=your_admin_password
